# Copy this file to .env and fill in real values for local development.
# Never commit a real .env file.

# --- Postgres (used by docker-compose and apps/api) ---
POSTGRES_USER=fulfillos
POSTGRES_PASSWORD=fulfillos
POSTGRES_DB=fulfillos
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fulfillos:fulfillos@localhost:5432/fulfillos

# --- Redis (used by docker-compose and apps/api) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- apps/api ---
PORT=3001
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-in-local-env

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:3001
