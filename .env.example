# Copy this file to .env and fill in real values for local development.
# Never commit a real .env file.

# --- Postgres (used by docker-compose and apps/api) ---
POSTGRES_USER=fulfillos
POSTGRES_PASSWORD=fulfillos
POSTGRES_DB=fulfillos
POSTGRES_TEST_DB=fulfillos_test
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fulfillos:fulfillos@localhost:5432/fulfillos
# Separate database for integration tests. Must never point at the same database as
# DATABASE_URL — the integration test harness refuses to run if it does.
DATABASE_URL_TEST=postgresql://fulfillos:fulfillos@localhost:5432/fulfillos_test

# --- Redis (used by docker-compose and apps/api) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Separate numbered Redis database for the HTTP security test suite (rate-limit counters get
# flushed between tests) — kept apart from whatever DB index dev/rate-limiting normally uses.
REDIS_URL_TEST=redis://localhost:6379/1

# --- apps/api ---
PORT=3001
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
# Cookie names for the session and CSRF tokens (see docs/architecture/authentication.md).
# Defaults shown here; only change if you know why.
SESSION_COOKIE_NAME=fulfillos.sid
CSRF_COOKIE_NAME=fulfillos.csrf

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:3001
